# Copy this file to .env and fill in your values
# NEVER commit .env to git

# PostgreSQL connection string
# Local:    postgres://postgres:password@localhost:5432/packageam
# Neon:     postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/packageam?sslmode=require
# Railway:  (copy from Railway dashboard)
DATABASE_URL=postgres://postgres:password@localhost:5432/packageam

# JWT — generate a strong random secret:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-secret

# Server
PORT=8080
ENV=development

# CORS — your Next.js frontend URL
FRONTEND_URL=http://localhost:3000

# Admin account (created automatically on first boot if set)
ADMIN_EMAIL=admin@package-am.com
ADMIN_PASSWORD=change-me-strong-password
